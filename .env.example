# Copy to .env.local (npm run dev creates it for you) and keep it private.
# Admin sign-in key for /admin/orders - 16+ random characters.
ADMIN_KEY=
# Optional (paths are relative to the project root; absolute paths also work):
# PORT=8787
# DATA_DIR=server-data
# GROUP_INVITE_SECRET=  (32+ random characters; signs group invite links. Unset: a key is generated once in DATA_DIR/group-invite.key.
#   Changing it makes every existing invite link stop working.)
# EMBROIDERY_LIBRARY_DIR=runtime-assets/embroidery-library  (the default; set only to use a library kept elsewhere.
#   Not under public/ on purpose: npm run build would copy all ~1.7 GB into dist/)
# EMBROIDERY_LAYERS_DIR=embroidery-library-layers   (the default colour-layers overlay)
# CHROME_PATH=  (only read by scripts/colourways/override-layers.mjs; the server finds Chrome / Edge itself)
